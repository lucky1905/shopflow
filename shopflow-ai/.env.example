# Copy to `.env` and adjust for your environment.

# Base URL of the FastAPI backend. The Vite dev server proxies `/api` to this
# address (see vite.config.ts), so leaving it as `/api` works in development.
VITE_API_URL=/api

# Absolute backend URL used at runtime in production builds.
VITE_API_BASE_URL=http://127.0.0.1:8000

# When `true`, feature services fall back to their local mock dataset instead
# of calling the backend. Set to `false` once the API is reachable.
VITE_USE_MOCK_API=false

VITE_APP_NAME="ShopFlow AI"
